{
  "name": "novadontic-backend",
  "version": "1.0.0",
  "description": "Single-client orthodontic lab management API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.prisma.json",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test src/app/api.test.ts src/modules/auth/auth.domain.test.ts src/shared/realtime/socket-server.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.22.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.6",
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "body-parser": "^2.3.0",
    "bullmq": "^6.3.8",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "socket.io": "^4.8.3",
    "tsx": "^4.23.15",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  }
}
