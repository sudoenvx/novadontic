enum TenantStatus {
  trial
  active
  past_due
  suspended
  cancelled

  @@map("tenant_status")
}

model SubscriptionPlan {
  id            BigInt   @id @default(autoincrement()) @db.BigInt
  code          String   @unique @db.VarChar(30)
  name          String   @db.VarChar(100)
  priceMonthly  Decimal  @default(0) @map("price_monthly") @db.Decimal(10, 2)
  currency      String   @default("USD") @db.Char(3)
  maxStaffUsers Int?     @map("max_staff_users") @db.SmallInt
  maxCasesMonth Int?     @map("max_cases_month")
  maxStorageGb  Int?     @map("max_storage_gb")
  features      Json     @default("{}") @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  tenants       Tenant[]

  @@map("subscription_plans")
}

model Tenant {
  id              BigInt       @id @default(autoincrement()) @db.BigInt
  slug            String       @unique @db.VarChar(60)
  name            String       @db.VarChar(150)
  legalName       String?      @map("legal_name") @db.VarChar(200)
  logoUrl         String?      @map("logo_url")
  brandColor      String?      @default("#1e88f5") @map("brand_color") @db.VarChar(7)
  timezone        String       @default("Africa/Cairo") @db.VarChar(50)
  defaultCurrency String       @default("EGP") @map("default_currency") @db.Char(3)
  planId          BigInt?      @map("plan_id") @db.BigInt
  status          TenantStatus @default(trial)
  trialEndsAt     DateTime?    @map("trial_ends_at") @db.Timestamptz(6)
  billingEmail    String?      @map("billing_email") @db.VarChar(150)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan                  SubscriptionPlan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  domains               TenantDomain[]
  settings              TenantSettings?
  counters              TenantCounter[]
  branding              TenantBranding?
  branches              TenantBranch[]
  users                 User[]
  roles                 Role[]
  portalAccess          TenantPortalAccess[]
  authSessions          AuthSession[]
  loginAttempts         LoginAttempt[]
  auditLogs             AuditLog[]
  impersonationSessions ImpersonationSession[]

  @@index([planId])
  @@map("tenants")
}

model TenantDomain {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  tenantId   BigInt   @map("tenant_id") @db.BigInt
  domain     String   @unique @db.VarChar(150)
  isVerified Boolean  @default(false) @map("is_verified")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domains")
}

model TenantSettings {
  tenantId  BigInt   @id @map("tenant_id") @db.BigInt
  settings  Json     @default("{}") @db.JsonB
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

model TenantCounter {
  tenantId    BigInt @map("tenant_id") @db.BigInt
  counterName String @map("counter_name") @db.VarChar(40)
  lastValue   BigInt @default(0) @map("last_value") @db.BigInt
  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, counterName])
  @@map("tenant_counters")
}

model TenantBranding {
  tenantId             BigInt   @id @map("tenant_id") @db.BigInt
  primaryColor         String?  @map("primary_color") @db.VarChar(7)
  secondaryColor       String?  @map("secondary_color") @db.VarChar(7)
  accentColor          String?  @map("accent_color") @db.VarChar(7)
  fontFamily           String?  @map("font_family") @db.VarChar(80)
  faviconUrl           String?  @map("favicon_url")
  loginBackgroundUrl   String?  @map("login_background_url")
  emailSenderName      String?  @map("email_sender_name") @db.VarChar(100)
  emailSenderAddress   String?  @map("email_sender_address") @db.VarChar(150)
  emailFooterHtml      String?  @map("email_footer_html")
  invoiceLetterheadUrl String?  @map("invoice_letterhead_url")
  documentFooterText   String?  @map("document_footer_text")
  portalWelcomeMessage String?  @map("portal_welcome_message")
  customCss            String?  @map("custom_css")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

model TenantBranch {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  tenantId  BigInt   @map("tenant_id") @db.BigInt
  name      String   @db.VarChar(100)
  address   String?
  phone     String?  @db.VarChar(30)
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, isActive])
  @@map("tenant_branches")
}
