enum PortalAccessRole {
  doctor
  clinic_staff @map("clinic_staff")

  @@map("portal_access_role")
}

enum PortalAccessStatus {
  invited
  active
  revoked

  @@map("portal_access_status")
}

model User {
  id                   BigInt                 @id @default(autoincrement()) @db.BigInt
  tenantId             BigInt                 @map("tenant_id") @db.BigInt
  fullName             String                 @map("full_name") @db.VarChar(150)
  email                String                 @db.VarChar(150)
  passwordHash         String                 @map("password_hash")
  phone                String?                @db.VarChar(30)
  avatarUrl            String?                @map("avatar_url")
  isActive             Boolean                @default(true) @map("is_active")
  failedLoginCount     Int                    @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil          DateTime?              @map("locked_until") @db.Timestamptz(6)
  mfaEnabled           Boolean                @default(false) @map("mfa_enabled")
  mfaSecretEncrypted   Bytes?                 @map("mfa_secret_encrypted") @db.ByteA
  lastLoginAt          DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles                UserRole[]
  staffSessions        AuthSession[]          @relation("StaffSessions")
  impersonationTargets ImpersonationSession[] @relation("StaffImpersonationTarget")
  auditLogs            AuditLog[]             @relation("StaffAuditActor")

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId, isActive])
  @@map("users")
}

model Role {
  id          BigInt           @id @default(autoincrement()) @db.BigInt
  tenantId    BigInt           @map("tenant_id") @db.BigInt
  code        String           @db.VarChar(40)
  name        String           @db.VarChar(100)
  isSystem    Boolean          @default(false) @map("is_system")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement()) @db.BigInt
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(40)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.BigInt
  permissionId BigInt     @map("permission_id") @db.BigInt
  tenantId     BigInt     @map("tenant_id") @db.BigInt
  role         Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model UserRole {
  userId   BigInt @map("user_id") @db.BigInt
  roleId   BigInt @map("role_id") @db.BigInt
  tenantId BigInt @map("tenant_id") @db.BigInt
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model PortalUser {
  id                   BigInt                 @id @default(autoincrement()) @db.BigInt
  email                String                 @unique @db.VarChar(150)
  passwordHash         String                 @map("password_hash")
  fullName             String                 @map("full_name") @db.VarChar(150)
  phone                String?                @db.VarChar(30)
  avatarUrl            String?                @map("avatar_url")
  isActive             Boolean                @default(true) @map("is_active")
  mfaEnabled           Boolean                @default(false) @map("mfa_enabled")
  lastLoginAt          DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  memberships          TenantPortalAccess[]
  portalSessions       AuthSession[]          @relation("PortalSessions")
  impersonationTargets ImpersonationSession[] @relation("PortalImpersonationTarget")
  auditLogs            AuditLog[]             @relation("PortalAuditActor")

  @@map("portal_users")
}

model TenantPortalAccess {
  id           BigInt             @id @default(autoincrement()) @db.BigInt
  tenantId     BigInt             @map("tenant_id") @db.BigInt
  portalUserId BigInt             @map("portal_user_id") @db.BigInt
  doctorId     BigInt?            @map("doctor_id") @db.BigInt
  role         PortalAccessRole   @default(doctor)
  status       PortalAccessStatus @default(invited)
  invitedAt    DateTime           @default(now()) @map("invited_at") @db.Timestamptz(6)
  acceptedAt   DateTime?          @map("accepted_at") @db.Timestamptz(6)
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalUser   PortalUser         @relation(fields: [portalUserId], references: [id], onDelete: Cascade)

  @@unique([tenantId, portalUserId])
  @@index([portalUserId, status])
  @@map("tenant_portal_access")
}

model AuthSession {
  id               String      @id @default(uuid()) @db.Uuid
  staffUserId      BigInt?     @map("staff_user_id") @db.BigInt
  portalUserId     BigInt?     @map("portal_user_id") @db.BigInt
  tenantId         BigInt?     @map("tenant_id") @db.BigInt
  refreshTokenHash String      @map("refresh_token_hash") @db.Char(64)
  ipAddress        String?     @map("ip_address") @db.Inet
  userAgent        String?     @map("user_agent")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime?   @map("revoked_at") @db.Timestamptz(6)
  staffUser        User?       @relation("StaffSessions", fields: [staffUserId], references: [id], onDelete: Cascade)
  portalUser       PortalUser? @relation("PortalSessions", fields: [portalUserId], references: [id], onDelete: Cascade)
  tenant           Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([staffUserId, revokedAt])
  @@index([portalUserId, revokedAt])
  @@index([tenantId, expiresAt])
  @@map("auth_sessions")
}

model LoginAttempt {
  id        BigInt   @id @default(autoincrement()) @db.BigInt
  email     String   @db.VarChar(150)
  tenantId  BigInt?  @map("tenant_id") @db.BigInt
  success   Boolean
  reason    String?  @db.VarChar(40)
  ipAddress String?  @map("ip_address") @db.Inet
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([tenantId, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id                     BigInt                @id @default(autoincrement()) @db.BigInt
  tenantId               BigInt?               @map("tenant_id") @db.BigInt
  staffUserId            BigInt?               @map("staff_user_id") @db.BigInt
  portalUserId           BigInt?               @map("portal_user_id") @db.BigInt
  action                 String                @db.VarChar(30)
  tableName              String?               @map("table_name") @db.VarChar(80)
  recordId               BigInt?               @map("record_id") @db.BigInt
  oldData                Json?                 @map("old_data") @db.JsonB
  newData                Json?                 @map("new_data") @db.JsonB
  ipAddress              String?               @map("ip_address") @db.Inet
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  impersonationSessionId BigInt?               @map("impersonation_session_id") @db.BigInt
  tenant                 Tenant?               @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  staffUser              User?                 @relation("StaffAuditActor", fields: [staffUserId], references: [id], onDelete: SetNull)
  portalUser             PortalUser?           @relation("PortalAuditActor", fields: [portalUserId], references: [id], onDelete: SetNull)
  impersonationSession   ImpersonationSession? @relation("AuditImpersonation", fields: [impersonationSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}
