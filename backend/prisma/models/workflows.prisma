model WorkflowTemplate {
  id              BigInt          @id @default(autoincrement()) @db.BigInt
  applianceTypeId BigInt?         @map("appliance_type_id") @db.BigInt
  name            String          @unique @db.VarChar(100)
  isDefault       Boolean         @default(false) @map("is_default")
  applianceType   ApplianceType?  @relation(fields: [applianceTypeId], references: [id], onDelete: SetNull)
  stages          WorkflowStage[]

  @@map("workflow_templates")
}

model WorkflowStage {
  id               BigInt           @id @default(autoincrement()) @db.BigInt
  templateId       BigInt           @map("template_id") @db.BigInt
  sortOrder        Int              @map("sort_order") @db.SmallInt
  name             String           @db.VarChar(80)
  slaHours         Int?             @map("sla_hours")
  requiresApproval Boolean          @default(false) @map("requires_approval")
  allowedFileKinds Json             @default("[\"stl\", \"photo\", \"pdf\", \"doc\"]") @map("allowed_file_kinds")
  template         WorkflowTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sortOrder])
  @@map("workflow_stages")
}
